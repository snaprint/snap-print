# Snap Print Environment Variables
# Copy this file to .env and fill in your values

# ── Google Sheets (Published CSV URLs) ──
# Publish your sheets as CSV: File → Share → Publish to web → CSV
VITE_PRODUCTS_CSV_URL=
VITE_SHIPPING_RATES_CSV_URL=
# Home-page hero carousel (column B = image URL)
VITE_HERO_IMAGES_CSV_URL=
# Order tracking sheet. Temporary: it exposes customer details publicly and
# will be removed when /api/track-order replaces it (F-1 / B-14).
VITE_ORDER_TRACKING_CSV_URL=

# ── Razorpay ──
# Get keys from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Razorpay Webhook ──
# Create at https://dashboard.razorpay.com/app/webhooks
# Event: payment.captured
# URL: https://your-domain.pages.dev/api/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend.com — free tier: 3000 emails/month) ──
# Sign up at https://resend.com
RESEND_API_KEY=
SELLER_EMAIL=hello@snaprint.in

# ── Google Sheets Logging (Orders Sheet) ──
# Optional: to log paid orders to a Google Sheet
# Create a service account and share the sheet with it
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=

# ── Cloudflare Turnstile (optional, bot protection) ──
# Site key (public): the quote and cancel forms show the widget only when set (F-20).
VITE_TURNSTILE_SITE_KEY=
# Secret (server): set it only after the widget is live, or those forms return 403 (B-6).
TURNSTILE_SECRET_KEY=

# ── Seller Admin Login (multi-seller) ──
# JSON array of seller accounts for /seller-login.html
# Add more objects to the array for additional sellers
SELLER_ACCOUNTS=[{"username":"yourname","password":"yourpassword"}]

# ── Firebase (Buyer Auth + Firestore) ──
# Get from Firebase Console → Project Settings → Your apps → Web app
# These are public identifiers (safe in frontend), not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
